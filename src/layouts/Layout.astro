---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AppsLaunchPopover from "../components/AppsLaunchPopover.astro";

const {
  title = "Liberating Scripture Collective",
  description = "The Liberating Scripture Collective creates open-access, trauma-informed scripture translation, learning resources, and pathways of spiritual support.",
  canonical,
  ogImage,
  ogImageAlt = "Liberating Scripture Collective: open-access, trauma-informed scripture translation and spiritual community",
  twitterCard = "summary_large_image",
  noindex = false,
  hideFooterNewsletter = false, // pages with their own Brevo form (e.g. /unsubscribe)
} = Astro.props;

const siteOrigin = "https://liberatingscripture.org";
const canonicalUrl = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : "");
const ogImageUrl = ogImage ?? `${siteOrigin}/assets/og/og-default.png`;

// Critical inline CSS — applied before the external stylesheet loads so the
// page background/text and header/main geometry are correct on first paint
// (no light flash for dark-mode users, no margin/CLS jump). Values mirror
// global.css's tokens: light --cream/--ink, dark #1a1e1a/#e4e2dc, and the
// 68px .site-header__inner height. The dark rules use the same dual mechanism
// as global.css so the pre-paint data-theme attribute wins: the media rule is
// guarded with :not([data-theme="light"]), and an explicit [data-theme="dark"]
// rule forces dark on any OS.
const criticalCSS = `html,body{margin:0;padding:0}body{background:#E1DFD9;color:#1D231C}.site-header{min-height:68px}.site-header__inner{min-height:68px;box-sizing:border-box}main{min-height:50svh}@media(prefers-color-scheme:dark){:root:not([data-theme="light"]) body{background:#1a1e1a;color:#e4e2dc}}:root[data-theme="dark"] body{background:#1a1e1a;color:#e4e2dc}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Apply the saved theme before first paint to avoid a flash of the wrong
         scheme. Absence of 'lsc-theme' = follow system (no attribute set, CSS
         falls through to prefers-color-scheme). Only 'light'/'dark' are honored. -->
    <script is:inline>try{var t=localStorage.getItem('lsc-theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=t;}}catch(_){}</script>

    <!-- Critical inline CSS: correct background/geometry before the external
         stylesheet loads (see criticalCSS in the frontmatter). -->
    <Fragment set:html={`<style>${criticalCSS}</style>`} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="Liberating Scripture Collective" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {/* Dimensions are only known for the default 1200×630 card; pages passing
        their own ogImage omit them rather than misreport. */}
    {!ogImage && <meta property="og:image:width" content="1200" />}
    {!ogImage && <meta property="og:image:height" content="630" />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#209D50" />
    <meta name="theme-color" content="#0F6B33" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <slot name="head" />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter hideNewsletter={hideFooterNewsletter} />
    <AppsLaunchPopover />
  </body>
</html>
