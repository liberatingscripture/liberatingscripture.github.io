---
// MIRROR of litbible.net/apps — this page should render identically to
// litbible.net/apps except for LSC's site header/footer. See CLAUDE.md
// "Apps Page & Announcement Popover".
//
// THIS FILE is the one deliberate fork: two sites cannot share a canonical
// URL, so the Layout props and JSON-LD head below are LSC's own. Keep only
// the section list in step with litbible's src/pages/apps.astro.
//
// Everything else is byte-identical and enforced by CI (.github/workflows/
// apps-mirror.yml): the components under src/components/apps/ and
// src/styles/pages/apps.css. Don't hand-edit those here — change them on
// litbible and copy the whole file across. LSC-only styling belongs in
// apps-bridge.css.
import Layout from "../layouts/Layout.astro";
// Bridge FIRST, then the litbible mirror — see apps-bridge.css's header.
import "../styles/pages/apps-bridge.css";
import "../styles/pages/apps.css";
import Hero from "../components/apps/Hero.astro";
import ExamplesSlider from "../components/apps/ExamplesSlider.astro";
import ReaderCallouts from "../components/apps/ReaderCallouts.astro";
import BigScreens from "../components/apps/BigScreens.astro";
import HumaneByDesign from "../components/apps/HumaneByDesign.astro";
import JoinBeta from "../components/apps/JoinBeta.astro";
import AboutTranslation from "../components/apps/AboutTranslation.astro";

const IOS_URL = "https://apps.apple.com/app/id6772577879";
const ANDROID_URL =
  "https://play.google.com/store/apps/details?id=com.litbible.app&pcampaignid=web_share";
---

<Layout
  title="The LIT Bible App | Liberating Scripture Collective"
  description="The LIT Bible app for iPhone and Android: the full Liberation and Inclusion Translation, plus notes, highlights, daily and Lectionary readings, and offline access. Free, with no account and no ads."
  canonical="https://liberatingscripture.org/apps/"
  ogImage="https://liberatingscripture.org/assets/og/og-apps.png"
  ogImageAlt="The LIT Bible app, now on iPhone and Android"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebPage",
            "@id": "https://liberatingscripture.org/apps/#webpage",
            url: "https://liberatingscripture.org/apps/",
            name: "The LIT Bible App | Liberating Scripture Collective",
            isPartOf: { "@id": "https://liberatingscripture.org/#website" },
            about: { "@id": "https://litbible.net/#translation" },
          },
          {
            "@type": "MobileApplication",
            name: "LIT Bible",
            operatingSystem: "iOS",
            applicationCategory: "BookApplication",
            url: IOS_URL,
            publisher: {
              "@type": "Organization",
              name: "Liberating Scripture Collective",
              url: "https://liberatingscripture.org",
            },
            offers: {
              "@type": "Offer",
              price: "0",
              priceCurrency: "USD",
            },
          },
          {
            "@type": "MobileApplication",
            name: "LIT Bible",
            operatingSystem: "Android",
            applicationCategory: "BookApplication",
            url: ANDROID_URL,
            publisher: {
              "@type": "Organization",
              name: "Liberating Scripture Collective",
              url: "https://liberatingscripture.org",
            },
            offers: {
              "@type": "Offer",
              price: "0",
              priceCurrency: "USD",
            },
          },
        ],
      })}
    />
  </Fragment>

  <div class="apps">
    <Hero />
    <AboutTranslation />
    <ExamplesSlider />
    <ReaderCallouts />
    <BigScreens />
    <HumaneByDesign />
    <JoinBeta />
  </div>
</Layout>
