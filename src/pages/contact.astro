---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact | Liberating Scripture Collective"
  description="Contact the Liberating Scripture Collective with questions, collaboration ideas, or media inquiries."
  canonical="https://liberatingscripture.org/contact/"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ContactPage",
        "@id": "https://liberatingscripture.org/contact/#webpage",
        url: "https://liberatingscripture.org/contact/",
        name: "Contact | Liberating Scripture Collective",
        isPartOf: { "@id": "https://liberatingscripture.org/#website" },
      })}
    />
  </Fragment>
  <div class="contact-page">

    <header class="contact-hero">
      <div class="content">
        <p class="eyebrow">Get in touch</p>
        <h1>Contact</h1>
        <p class="lede">
          Questions, collaboration ideas, media inquiries, or just a note:
          send it our way. We'll respond as soon as we can.
        </p>
      </div>
    </header>

    <div class="contact-content content">
      <div class="contact-grid">

        <div class="contact-form-wrap">
          {/* Shown only when arriving from the "Get notified" CTA on /podcasts/
              (/contact/?topic=twb). Progressive enhancement: the param is read
              client-side, so no-JS visitors just see the normal form. */}
          <p id="topic-hint" class="topic-hint" hidden>
            Interested in <strong>The Table We're Building</strong>? We'll let
            you know when it launches. The message below is ready to send, or
            make it your own.
          </p>

          {/* Posts to the contact-form Worker (workers/contact-form/), which
              verifies the Turnstile token server-side and delivers via
              Cloudflare Email Routing. The form also degrades to a native
              POST (e.g. if fetch is blocked); Turnstile still requires JS to
              render, so a truly JS-less visitor can't pass the check. The
              Worker 303-redirects to /contact/thanks/ on success. */}
          <form
            class="contact-form"
            action="/contact/submit"
            method="POST"
          >
            <div class="field">
              <label for="contact-name">Your name <span class="required" aria-hidden="true">*</span></label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                autocomplete="name"
              />
            </div>

            <div class="field">
              <label for="contact-email">Your email <span class="required" aria-hidden="true">*</span></label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                autocomplete="email"
              />
            </div>

            <div class="field">
              <label for="contact-message">Message <span class="required" aria-hidden="true">*</span></label>
              <textarea
                id="contact-message"
                name="message"
                rows="7"
                required
              ></textarea>
            </div>

            <!-- Honeypot -->
            <div class="hp" aria-hidden="true">
              <label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" /></label>
            </div>

            <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
            <div id="contact-turnstile" class="cf-turnstile" data-sitekey="0x4AAAAAACJ446flkL7Rwf8i"></div>

            <div id="form-status" class="form-status" role="status" aria-live="polite" aria-atomic="true"></div>

            <button type="submit" class="btn contact-submit"><span>Send message</span></button>

            <p class="contact-notice">
              Fields marked <span aria-hidden="true">*</span><span class="sr-only">with an asterisk</span> are required.
              This form is not for sensitive personal information.
              We will never sell or share your information.
            </p>
          </form>

          <script>
            (() => {
              const form = document.querySelector(".contact-form") as HTMLFormElement | null;
              const statusEl = document.getElementById("form-status");
              const submitBtn = form?.querySelector("button[type='submit']") as HTMLButtonElement | null;
              if (!form || !statusEl || !submitBtn) return;

              // Context for arrivals from the /podcasts/ "Get notified" CTA.
              if (new URLSearchParams(location.search).get("topic") === "twb") {
                document.getElementById("topic-hint")?.removeAttribute("hidden");
                const message = form.querySelector<HTMLTextAreaElement>("#contact-message");
                if (message && !message.value.trim()) {
                  message.value = "I'd like to be notified when The Table We're Building launches.";
                }
              }

              const turnstile = () => (window as any).turnstile;

              form.addEventListener("submit", async (e) => {
                e.preventDefault();
                if (!form.checkValidity()) { form.reportValidity(); return; }

                const token = form.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]');
                if (!token || !token.value) {
                  statusEl.textContent = "Please complete the security check before sending.";
                  statusEl.className = "form-status form-status--error";
                  return;
                }

                submitBtn.disabled = true;
                submitBtn.innerHTML = "<span>Sending…</span>";
                statusEl.textContent = "";
                statusEl.className = "form-status";

                try {
                  const res = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form),
                    headers: { Accept: "application/json" },
                  });

                  if (res.ok) {
                    statusEl.textContent = "Message sent! We'll be in touch soon.";
                    statusEl.className = "form-status form-status--success";
                    form.reset();
                  } else {
                    statusEl.textContent =
                      res.status === 403
                        ? "The security check could not be verified. Please complete it again and resend."
                        : res.status === 429
                          ? "Several messages were sent in a short time. Please wait a minute and try again."
                          : "Something went wrong. Please try again.";
                    statusEl.className = "form-status form-status--error";
                  }
                  // Turnstile tokens are single-use: the server consumed this
                  // one either way, so the next attempt needs a fresh pass.
                  // Reset by container — the footer's newsletter renders a
                  // second Turnstile widget, so a bare reset() is ambiguous.
                  turnstile()?.reset("#contact-turnstile");
                } catch {
                  statusEl.textContent = "Couldn't send the message. Check your connection and try again.";
                  statusEl.className = "form-status form-status--error";
                }

                submitBtn.disabled = false;
                submitBtn.innerHTML = "<span>Send message</span>";
              });
            })();
          </script>
        </div>

        <aside class="contact-sidebar">
          <div class="contact-sidebar__section">
            <h2>What to expect</h2>
            <p>
              We're a small team and this work is part of a larger life.
              We'll do our best to respond within a week, often sooner.
            </p>
          </div>
          <div class="contact-sidebar__section">
            <h2>Common reasons to write</h2>
            <ul>
              <li>You want to collaborate on a project</li>
              <li>You're a spiritual director interested in joining the directory</li>
              <li>You have feedback on a translation choice</li>
              <li>You want to support the work and have questions</li>
              <li>You're a journalist, researcher, or podcaster</li>
              <li>You just want to say something</li>
            </ul>
          </div>
          <div class="contact-sidebar__section">
            <h2>Other paths</h2>
            <ul class="contact-sidebar__links">
              <li><a href="/lit-bible/">LIT Bible</a></li>
              <li><a href="/about/">About LSC</a></li>
              <li><a href="/support/">Support the work</a></li>
            </ul>
          </div>
        </aside>

      </div>
    </div>
  </div>
</Layout>

<style>
  .contact-hero {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: clamp(3rem, 6vw, 5rem) 0;
    position: relative;
  }

  .contact-hero .content {
    max-width: calc(64 * var(--ch));
  }

  .contact-hero::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 5px;
    background: var(--green);
  }

  .contact-hero h1 {
    font-family: "Crimson Text", Georgia, serif;
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    color: var(--text-strong);
    margin: 0.75rem 0 1rem;
  }

  .contact-hero .eyebrow { color: var(--green-text); }

  .contact-content {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 4rem;
    align-items: start;
  }

  .topic-hint {
    font-size: 0.9rem;
    line-height: 1.55;
    background: rgba(32, 157, 80, 0.1);
    color: #166b39;
    border: 1px solid rgba(32, 157, 80, 0.3);
    border-radius: 8px;
    padding: 0.85rem 1.1rem;
    margin: 0 0 1.75rem;
  }

  /* Form */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-family: Inter, sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-strong);
  }

  .required { color: var(--green-text); }

  .field input,
  .field select,
  .field textarea {
    background: var(--surface-raised);
    border: 1.5px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    font-family: Inter, sans-serif;
    font-size: 1rem;
    color: var(--text);
    transition: border-color 160ms, box-shadow 160ms;
    -webkit-appearance: none;
    appearance: none;
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 2px;
    border-color: var(--green);
  }

  .field textarea { resize: vertical; min-height: 160px; }

  .hp { position: absolute; left: -9999px; }

  .contact-submit { align-self: flex-start; }

  .contact-notice {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .form-status {
    font-size: 0.9rem;
    line-height: 1.5;
    border-radius: 8px;
    padding: 0;
    min-height: 0;
  }

  .form-status:not(:empty) {
    padding: 0.75rem 1rem;
  }

  .form-status--success {
    background: rgba(32, 157, 80, 0.1);
    color: #166b39;
    border: 1px solid rgba(32, 157, 80, 0.3);
  }

  .form-status--error {
    background: rgba(200, 50, 50, 0.08);
    color: #8b1a1a;
    border: 1px solid rgba(200, 50, 50, 0.25);
  }

  /* Dark mode: the deep success/error/topic text goes dark-on-dark against the
     subtle tinted panels, so flip it to light variants (backgrounds and borders
     read fine either way). Same double-block pattern global.css uses. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .form-status--success,
    :root:not([data-theme="light"]) .topic-hint {
      color: #7ed6a0;
    }
    :root:not([data-theme="light"]) .form-status--error {
      color: #e08a8a;
    }
  }

  :root[data-theme="dark"] .form-status--success,
  :root[data-theme="dark"] .topic-hint {
    color: #7ed6a0;
  }
  :root[data-theme="dark"] .form-status--error {
    color: #e08a8a;
  }

  .cf-turnstile { margin-top: 0.25rem; }

  /* Sidebar */
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-sidebar__section h2 {
    font-size: 1rem;
    margin: 0 0 0.6rem;
    font-family: Inter, sans-serif;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .contact-sidebar__section p,
  .contact-sidebar__section ul {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text);
    margin: 0;
  }

  .contact-sidebar__section ul { padding-left: 1.2rem; }
  .contact-sidebar__section li { margin-bottom: 0.3rem; }

  .contact-sidebar__links {
    list-style: none;
    padding: 0;
  }

  .contact-sidebar__links li { margin: 0; }
  .contact-sidebar__links a {
    font-size: 0.9rem;
    color: var(--green-text);
    display: block;
    padding: 0.3rem 0;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .contact-sidebar { position: static; }
  }
</style>
