---
import LscMark from "./LscMark.astro";

const navLinks = [
  { label: "About", href: "/about/" },
  { label: "LIT Bible", href: "/lit-bible/" },
  { label: "Podcasts", href: "/podcasts/" },
  { label: "Spiritual Companionship", href: "/spiritual-direction/" },
  { label: "Community", href: "/community/" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Liberating Scripture Collective home">
      <LscMark size={40} />
      <span class="site-header__name">
        <span class="name-long">Liberating Scripture Collective</span>
        <span class="name-short" aria-hidden="true">LSC</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {navLinks.map(link => (
          <li>
            <a href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
        <li class="site-nav__cta-item">
          <a href="/support/" class="site-header__cta btn"><span>Support</span></a>
        </li>
        <li class="site-nav__theme-item">
          <button
            class="site-header__theme-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="themeTray"
            aria-haspopup="dialog"
            data-theme-toggle
          >
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
              <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" />
            </svg>
            <span class="sr-only">Theme</span>
          </button>
        </li>
      </ul>
    </nav>

    <div class="site-header__actions">
      <button
        class="site-header__theme-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="themeTray"
        aria-haspopup="dialog"
        data-theme-toggle
      >
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" />
        </svg>
        <span class="sr-only">Theme</span>
      </button>
      <button
        class="site-header__menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-controls="mobileMenu"
        aria-expanded="false"
        aria-haspopup="dialog"
      >
        <span class="menu-icon" aria-hidden="true"></span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <!-- No-JS navigation fallback. Under 900px the real nav collapses to the
       JS-only overlay, whose toggle does nothing without JS. Render a plain
       nav row (only shown < 900px, where .site-nav is hidden) and hide the two
       JS-only toggles. Mirrors SiteFooter's noscript pattern: <style is:inline>
       with global selectors, since the styled elements are Astro-scoped. -->
  <noscript>
    <style is:inline>
      /* JS-only controls do nothing without JS — hide both toggles at every
         width. !important beats the scoped display rules on these buttons. */
      .site-header__menu-toggle,
      .site-header__theme-toggle { display: none !important; }
      /* Fallback nav: only under 900px, where the real .site-nav is hidden.
         On desktop the real nav works without JS, so keep the fallback out. */
      .site-header__noscript-nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.15rem 0.4rem;
        padding: 0.4rem var(--gutter) 0.7rem;
        border-top: 1px solid var(--border);
      }
      .site-header__noscript-nav a {
        font-family: Inter, sans-serif;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--text);
        text-decoration: none;
        padding: 0.3rem 0.5rem;
        border-radius: 8px;
      }
      @media (min-width: 901px) {
        .site-header__noscript-nav { display: none; }
      }
    </style>
    <nav class="site-header__noscript-nav" aria-label="Primary">
      {navLinks.map(link => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href="/support/">Support</a>
    </nav>
  </noscript>

  <!-- Mobile overlay -->
  <div class="menu-overlay" id="mobileMenu">
    <div class="menu-overlay__panel" role="dialog" aria-modal="true" aria-label="Site menu" tabindex="-1">
      <button class="menu-overlay__close" type="button" aria-label="Close menu">
        <span aria-hidden="true">✕</span>
      </button>
      <nav class="menu-overlay__nav" aria-label="Primary (mobile)">
        {navLinks.map(link => (
          <a href={link.href}>
            {link.label}
          </a>
        ))}
        <a href="/support/" class="menu-overlay__cta">Support</a>
      </nav>
    </div>
  </div>

  <!-- Theme tray (System / Light / Dark). Opened by either theme toggle above;
       the script re-parents it to <body> so it escapes the sticky header's
       stacking context. Hidden without JS. -->
  <div class="theme-tray" id="themeTray" hidden role="dialog" aria-labelledby="themeTrayHeading">
    <fieldset class="theme-tray__fieldset">
      <legend class="theme-tray__legend" id="themeTrayHeading">Theme</legend>
      <div class="theme-tray__seg">
        <label class="theme-tray__seg-option">
          <input type="radio" class="theme-tray__seg-input" name="lsc-theme" value="system" data-theme-radio />
          <span class="theme-tray__seg-text">System</span>
        </label>
        <label class="theme-tray__seg-option">
          <input type="radio" class="theme-tray__seg-input" name="lsc-theme" value="light" data-theme-radio />
          <span class="theme-tray__seg-text">Light</span>
        </label>
        <label class="theme-tray__seg-option">
          <input type="radio" class="theme-tray__seg-input" name="lsc-theme" value="dark" data-theme-radio />
          <span class="theme-tray__seg-text">Dark</span>
        </label>
      </div>
    </fieldset>
  </div>

  <script>
    (() => {
      const toggle = document.querySelector(".site-header__menu-toggle") as HTMLButtonElement | null;
      const overlay = document.getElementById("mobileMenu");
      const panel = overlay?.querySelector(".menu-overlay__panel") as HTMLElement | null;
      const closeBtn = overlay?.querySelector(".menu-overlay__close") as HTMLButtonElement | null;
      if (!toggle || !overlay || !panel) return;

      let lastActive: Element | null = null;

      const setOpen = (open: boolean) => {
        overlay.classList.toggle("is-open", open);
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        document.documentElement.classList.toggle("menu-open", open);
        // Inert everything focusable outside the dialog so both the tab order
        // and the a11y tree are contained inside it. The overlay is a sibling
        // of .site-header__inner within <header>, so inert the inner (not the
        // whole header) plus the skip link, main, and footer. Native inert on
        // all of them IS the focus trap — no manual wrap handling needed.
        const regions = [
          document.querySelector(".skip-link"),
          document.querySelector(".site-header__inner"),
          document.querySelector("main"),
          document.querySelector("footer"),
        ];
        for (const el of regions) {
          if (el) (el as HTMLElement & { inert: boolean }).inert = open;
        }
      };

      const open = () => { lastActive = document.activeElement; setOpen(true); panel.focus({ preventScroll: true }); };
      const close = () => { setOpen(false); ((lastActive as HTMLElement)?.focus ? lastActive as HTMLElement : toggle).focus?.({ preventScroll: true }); };
      const isOpen = () => overlay.classList.contains("is-open");

      toggle.addEventListener("click", e => { e.preventDefault(); isOpen() ? close() : open(); });
      closeBtn?.addEventListener("click", () => close());
      overlay.addEventListener("click", e => { if (e.target === overlay) close(); });
      document.addEventListener("keydown", e => { if (e.key === "Escape" && isOpen()) close(); });
      overlay.querySelectorAll("a").forEach(a => a.addEventListener("click", () => close()));

      // Title truncation
      const nameEl = document.querySelector<HTMLElement>(".site-header__name");
      const longEl = nameEl?.querySelector<HTMLElement>(".name-long");
      const shortEl = nameEl?.querySelector<HTMLElement>(".name-short");
      if (nameEl && longEl && shortEl) {
        const check = () => {
          longEl.style.display = "inline";
          shortEl.style.display = "none";
          if (longEl.scrollWidth > longEl.clientWidth + 2) {
            longEl.style.display = "none";
            shortEl.style.display = "inline";
          }
        };
        const inner = document.querySelector<HTMLElement>(".site-header__inner");
        if (inner) new ResizeObserver(() => requestAnimationFrame(check)).observe(inner);
        check();
      }
    })();
  </script>

  <script>
    // Theme tray: a System/Light/Dark segmented control shared by both header
    // toggles. Mirrors the pre-paint script in Layout.astro (storage key
    // 'lsc-theme'): light/dark stamp data-theme + colorScheme; system clears
    // both so CSS follows prefers-color-scheme.
    (() => {
      const openers = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
      );
      const tray = document.getElementById("themeTray");
      if (!openers.length || !tray) return;
      const radios = Array.from(
        tray.querySelectorAll<HTMLInputElement>("[data-theme-radio]")
      );

      // Escape the sticky header's stacking context.
      document.body.appendChild(tray);

      let activeOpener: HTMLButtonElement | null = null;
      const isOpen = () => !tray.hasAttribute("hidden");
      const currentTheme = () =>
        document.documentElement.getAttribute("data-theme") || "system";

      const syncRadios = () => {
        const active = currentTheme();
        for (const r of radios) r.checked = r.value === active;
      };

      const positionTray = (opener: HTMLButtonElement) => {
        const rect = opener.getBoundingClientRect();
        tray.style.top = `${rect.bottom + 8}px`;
        tray.style.right = `${Math.max(8, window.innerWidth - rect.right)}px`;
      };

      const openTray = (opener: HTMLButtonElement) => {
        activeOpener = opener;
        syncRadios();
        tray.removeAttribute("hidden");
        positionTray(opener);
        opener.setAttribute("aria-expanded", "true");
        (radios.find(r => r.checked) || radios[0])?.focus({ preventScroll: true });
      };

      const closeTray = (returnFocus = true) => {
        tray.setAttribute("hidden", "");
        for (const o of openers) o.setAttribute("aria-expanded", "false");
        if (returnFocus) activeOpener?.focus({ preventScroll: true });
        activeOpener = null;
      };

      for (const opener of openers) {
        opener.addEventListener("click", e => {
          e.preventDefault();
          isOpen() && activeOpener === opener ? closeTray() : openTray(opener);
        });
      }

      document.addEventListener("keydown", e => {
        if (e.key === "Escape" && isOpen()) closeTray();
      });

      document.addEventListener("click", e => {
        if (!isOpen()) return;
        const t = e.target as Node;
        if (tray.contains(t) || openers.some(o => o.contains(t))) return;
        closeTray(false);
      });

      window.addEventListener("resize", () => {
        if (isOpen() && activeOpener) positionTray(activeOpener);
      });

      for (const radio of radios) {
        radio.addEventListener("change", () => {
          if (!radio.checked) return;
          const v = radio.value; // 'system' | 'light' | 'dark'
          const root = document.documentElement;
          if (v === "light" || v === "dark") {
            root.setAttribute("data-theme", v);
            root.style.colorScheme = v;
          } else {
            root.removeAttribute("data-theme");
            root.style.colorScheme = "";
          }
          try {
            v === "system"
              ? localStorage.removeItem("lsc-theme")
              : localStorage.setItem("lsc-theme", v);
          } catch (_) {}
        });
      }

      syncRadios();
    })();
  </script>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--surface-raised);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 1px 12px rgba(0,0,0,0.06);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 68px;
    width: min(var(--container-max), calc(100% - (var(--gutter) * 2)));
    margin-inline: auto;
  }

  /* Brand */
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
    min-width: 0;
  }

  .site-header__name {
    font-family: "Crimson Text", Georgia, serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-strong);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 260px;
  }

  .name-short { display: none; }

  /* Desktop nav */
  .site-nav { display: flex; align-items: center; }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__list li a {
    display: block;
    padding: 0.5rem 0.75rem;
    font-family: Inter, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    border-radius: 8px;
    transition: background 160ms, color 160ms;
  }

  .site-nav__list li a:hover,
  .site-nav__list li a:focus-visible {
    background: rgba(32, 157, 80, 0.1);
    color: var(--green-text);
    text-decoration: none;
  }

  .site-nav__cta-item a {
    padding: 8px 18px !important;
    /* CTA tokens, not raw --ink/--green: --ink is theme-invariant and sits
       almost exactly on the dark header surface, which left this pill
       shapeless in dark mode. */
    background: var(--cta-bg) !important;
    color: var(--cta-text) !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem !important;
    border-radius: 10px !important;
  }

  .site-nav__cta-item a:hover,
  .site-nav__cta-item a:focus-visible {
    background: var(--green) !important;
    color: var(--ink) !important;
  }

  /* Theme toggle button (both the desktop nav item and the mobile actions
     copy share this class; each is shown/hidden with its container). */
  .site-nav__theme-item {
    display: flex;
    align-items: center;
    margin-left: 0.5rem;
  }

  .site-header__theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
  }

  .site-header__theme-toggle:hover {
    background: var(--green-text);
    color: var(--on-green-fill);
    border-color: transparent;
  }

  /* Theme tray (re-parented to <body> by the script) */
  .theme-tray {
    position: fixed;
    z-index: 2000;
    min-width: 220px;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
    padding: 14px;
  }

  .theme-tray[hidden] { display: none; }

  .theme-tray__fieldset {
    display: block;
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .theme-tray__legend {
    font-family: Inter, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    padding: 0;
    margin: 0 0 8px;
  }

  .theme-tray__seg {
    display: flex;
    background: var(--surface-input);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }

  .theme-tray__seg-option {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 6px 10px;
    cursor: pointer;
  }

  .theme-tray__seg-option + .theme-tray__seg-option {
    border-left: 1px solid var(--border);
  }

  .theme-tray__seg-input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .theme-tray__seg-text {
    font-family: Inter, sans-serif;
    font-size: 0.875rem;
    color: var(--text);
    transition: color 150ms ease;
  }

  /* Selected pill: ink-on-green (~4.6:1) passes AA at this size in both themes,
     since neither --ink nor --green shifts with the theme. */
  .theme-tray__seg-input:checked + .theme-tray__seg-text {
    color: var(--ink);
  }

  .theme-tray__seg-option:has(.theme-tray__seg-input:checked) {
    background: var(--green);
  }

  .theme-tray__seg-input:focus-visible + .theme-tray__seg-text {
    outline: 2px solid var(--text);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Actions area */
  .site-header__actions { display: none; }

  /* Menu toggle */
  .site-header__menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 8px;
    padding: 0;
    color: var(--text);
  }

  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 280ms, opacity 280ms;
  }

  .menu-icon { position: relative; }
  .menu-icon::before,
  .menu-icon::after {
    content: "";
    position: absolute;
    left: 0;
  }
  .menu-icon::before { top: -7px; }
  .menu-icon::after { top: 7px; }

  /* Mobile overlay */
  .menu-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(29, 35, 28, 0.55);
    backdrop-filter: blur(2px);
  }

  .menu-overlay.is-open { display: block; }

  .menu-overlay__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 85vw);
    background: var(--surface-raised);
    padding: 2rem 1.5rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    outline: none;
  }

  .menu-overlay__close {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: flex-end;
    width: 40px;
    height: 40px;
    background: none;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-size: 1rem;
    cursor: pointer;
    flex-shrink: 0;
  }

  .menu-overlay__close:hover {
    background: rgba(32, 157, 80, 0.1);
    border-color: var(--green);
    color: var(--green-text);
  }

  .menu-overlay__nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1rem;
  }

  .menu-overlay__nav a {
    display: block;
    padding: 0.85rem 1rem;
    font-family: Inter, sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    border-radius: 10px;
    transition: background 160ms;
  }

  .menu-overlay__nav a:hover { background: rgba(32,157,80,0.1); }

  .menu-overlay__cta {
    margin-top: 1rem;
    /* Same reasoning as .site-nav__cta-item a — see above. */
    background: var(--cta-bg) !important;
    color: var(--cta-text) !important;
    font-weight: 700 !important;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-align: center;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .site-nav { display: none; }
    .site-header__actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .site-header__name { max-width: 180px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__theme-toggle,
    .theme-tray__seg-text { transition: none; }
  }
</style>
