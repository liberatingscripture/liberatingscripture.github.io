---
const navLinks = [
  { label: "About", href: "/about/" },
  { label: "LIT Bible", href: "/lit-bible/" },
  { label: "Podcasts", href: "/podcasts/" },
  { label: "Spiritual Direction", href: "/spiritual-direction/" },
  { label: "Community", href: "/community/" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Liberating Scripture Collective home">
      <img
        src="/assets/images/lsc-logo.png"
        alt=""
        class="site-header__logo"
        width="40"
        height="40"
        loading="eager"
        decoding="async"
      />
      <span class="site-header__name">
        <span class="name-long">Liberating Scripture Collective</span>
        <span class="name-short" aria-hidden="true">LSC</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              {link.label}
              {link.external && <span class="ext-icon" aria-label=" (opens in new tab)">↗</span>}
            </a>
          </li>
        ))}
        <li class="site-nav__cta-item">
          <a href="/support/" class="site-header__cta btn"><span>Support</span></a>
        </li>
      </ul>
    </nav>

    <div class="site-header__actions">
      <button
        class="site-header__menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-controls="mobileMenu"
        aria-expanded="false"
        aria-haspopup="dialog"
      >
        <span class="menu-icon" aria-hidden="true"></span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile overlay -->
  <div class="menu-overlay" id="mobileMenu">
    <div class="menu-overlay__panel" role="dialog" aria-modal="true" aria-label="Site menu" tabindex="-1">
      <button class="menu-overlay__close" type="button" aria-label="Close menu">
        <span aria-hidden="true">✕</span>
      </button>
      <nav class="menu-overlay__nav" aria-label="Primary (mobile)">
        {navLinks.map(link => (
          <a
            href={link.href}
            {...(link.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            {link.label}
            {link.external && <span aria-label=" (opens in new tab)">↗</span>}
          </a>
        ))}
        <a href="/support/" class="menu-overlay__cta">Support</a>
      </nav>
    </div>
  </div>

  <script>
    (() => {
      const toggle = document.querySelector(".site-header__menu-toggle") as HTMLButtonElement | null;
      const overlay = document.getElementById("mobileMenu");
      const panel = overlay?.querySelector(".menu-overlay__panel") as HTMLElement | null;
      const closeBtn = overlay?.querySelector(".menu-overlay__close") as HTMLButtonElement | null;
      if (!toggle || !overlay || !panel) return;

      let lastActive: Element | null = null;

      const setOpen = (open: boolean) => {
        overlay.classList.toggle("is-open", open);
        toggle.setAttribute("aria-expanded", open ? "true" : "false");
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        document.documentElement.classList.toggle("menu-open", open);
        // Mark the rest of the page inert so AT is contained inside the dialog
        const main = document.querySelector("main");
        const footer = document.querySelector("footer");
        if (main) (main as HTMLElement & { inert: boolean }).inert = open;
        if (footer) (footer as HTMLElement & { inert: boolean }).inert = open;
      };

      const open = () => { lastActive = document.activeElement; setOpen(true); panel.focus({ preventScroll: true }); };
      const close = () => { setOpen(false); ((lastActive as HTMLElement)?.focus ? lastActive as HTMLElement : toggle).focus?.({ preventScroll: true }); };
      const isOpen = () => overlay.classList.contains("is-open");

      toggle.addEventListener("click", e => { e.preventDefault(); isOpen() ? close() : open(); });
      closeBtn?.addEventListener("click", () => close());
      overlay.addEventListener("click", e => { if (e.target === overlay) close(); });
      document.addEventListener("keydown", e => { if (e.key === "Escape" && isOpen()) close(); });
      overlay.querySelectorAll("a").forEach(a => a.addEventListener("click", () => close()));

      // Title truncation
      const nameEl = document.querySelector<HTMLElement>(".site-header__name");
      const longEl = nameEl?.querySelector<HTMLElement>(".name-long");
      const shortEl = nameEl?.querySelector<HTMLElement>(".name-short");
      if (nameEl && longEl && shortEl) {
        const check = () => {
          longEl.style.display = "inline";
          shortEl.style.display = "none";
          if (longEl.scrollWidth > longEl.clientWidth + 2) {
            longEl.style.display = "none";
            shortEl.style.display = "inline";
          }
        };
        const inner = document.querySelector<HTMLElement>(".site-header__inner");
        if (inner) new ResizeObserver(() => requestAnimationFrame(check)).observe(inner);
        check();
      }
    })();
  </script>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--surface-raised);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 1px 12px rgba(0,0,0,0.06);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 68px;
    width: min(var(--container-max), calc(100% - (var(--gutter) * 2)));
    margin-inline: auto;
  }

  /* Brand */
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
    min-width: 0;
  }

  .site-header__logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .site-header__name {
    font-family: "Crimson Text", Georgia, serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-strong);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 260px;
  }

  .name-short { display: none; }

  /* Desktop nav */
  .site-nav { display: flex; align-items: center; }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__list li a {
    display: block;
    padding: 0.5rem 0.75rem;
    font-family: Inter, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    border-radius: 8px;
    transition: background 160ms, color 160ms;
  }

  .site-nav__list li a:hover,
  .site-nav__list li a:focus-visible {
    background: rgba(32, 157, 80, 0.1);
    color: var(--green);
    text-decoration: none;
  }

  .ext-icon {
    font-size: 0.75em;
    margin-left: 0.2em;
    opacity: 0.6;
  }

  .site-nav__cta-item a {
    padding: 8px 18px !important;
    background: var(--ink) !important;
    color: var(--green) !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem !important;
    border-radius: 10px !important;
  }

  .site-nav__cta-item a:hover,
  .site-nav__cta-item a:focus-visible {
    background: var(--green) !important;
    color: var(--ink) !important;
  }

  /* Actions area */
  .site-header__actions { display: none; }

  /* Menu toggle */
  .site-header__menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 8px;
    padding: 0;
    color: var(--text);
  }

  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 280ms, opacity 280ms;
  }

  .menu-icon { position: relative; }
  .menu-icon::before,
  .menu-icon::after {
    content: "";
    position: absolute;
    left: 0;
  }
  .menu-icon::before { top: -7px; }
  .menu-icon::after { top: 7px; }

  /* Mobile overlay */
  .menu-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(29, 35, 28, 0.55);
    backdrop-filter: blur(2px);
  }

  .menu-overlay.is-open { display: block; }

  .menu-overlay__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 85vw);
    background: var(--surface-raised);
    padding: 2rem 1.5rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    outline: none;
  }

  .menu-overlay__close {
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: flex-end;
    width: 40px;
    height: 40px;
    background: none;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-size: 1rem;
    cursor: pointer;
    flex-shrink: 0;
  }

  .menu-overlay__close:hover {
    background: rgba(32, 157, 80, 0.1);
    border-color: var(--green);
    color: var(--green);
  }

  .menu-overlay__nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1rem;
  }

  .menu-overlay__nav a {
    display: block;
    padding: 0.85rem 1rem;
    font-family: Inter, sans-serif;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    border-radius: 10px;
    transition: background 160ms;
  }

  .menu-overlay__nav a:hover { background: rgba(32,157,80,0.1); }

  .menu-overlay__cta {
    margin-top: 1rem;
    background: var(--ink) !important;
    color: var(--green) !important;
    font-weight: 700 !important;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-align: center;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .site-nav { display: none; }
    .site-header__actions { display: block; }
  }

  @media (max-width: 480px) {
    .site-header__name { max-width: 180px; }
  }
</style>
