---
/**
 * hideNewsletter: omit the Brevo subscribe form. Used on /unsubscribe, which
 * embeds its own Brevo form — Brevo markup requires fixed ids (sib-form,
 * error-message, success-message), so two forms on one page collide.
 */
const { hideNewsletter = false } = Astro.props;

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-brand">
      <img
        src="/assets/images/lsc-logo.png"
        alt="Liberating Scripture Collective"
        width="80"
        height="80"
        loading="lazy"
        decoding="async"
      />
      <p class="footer-tagline">
        Open-access, trauma-informed scripture translation, teaching, and
        community.
      </p>
      <p class="footer-legal">
        © <span id="footerYear">{year}</span> Liberating Scripture Collective<br />
        Founded by Brandon&nbsp;Vélez&nbsp;Johnson
      </p>
    </div>

    <nav class="footer-col" aria-label="Projects">
      <h2 class="footer-col__heading">Projects</h2>
      <ul>
        <li><a href="/lit-bible/">LIT Bible</a></li>
        <li><a href="/apps/">LIT Bible App</a></li>
        <li>
          <a
            href="https://litbible.net/found-in-translation-podcast"
            target="_blank"
            rel="noopener noreferrer">Found in Translation ↗</a>
        </li>
        <li><a href="/podcasts/">The Table We're Building</a></li>
        <li><a href="/spiritual-direction/">Spiritual Companionship</a></li>
        <li><a href="/community/">Community &amp; Courses</a></li>
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Organization">
      <h2 class="footer-col__heading">Organization</h2>
      <ul>
        <li><a href="/about/">About LSC</a></li>
        <li>
          <a
            href="https://litbible.net/liberating-scripture-collective"
            target="_blank"
            rel="noopener noreferrer">LSC on litbible.net ↗</a>
        </li>
        <li><a href="/support/">Support the Work</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </nav>

    <div class="footer-col footer-col--cta">
      <a href="/support/" class="btn footer-cta-btn"
        ><span>Support the Work</span></a
      >
      <a
        href="https://litbible.net/read"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--outline footer-cta-btn"
      >
        <span>Read the LIT Bible ↗</span>
      </a>

      {/* Newsletter — posts to LSC's own Brevo list (same Brevo account as
          litbible.net, but a dedicated list, not litbible's translation-update
          list). The Turnstile widget is likewise our own, scoped to this
          domain.

          This deliberately does NOT load Brevo's `main.js`. That script binds
          to the structural markup Brevo's generated snippet ships with
          (.sib-form, #sib-form-container, #sib-container, .entry__field,
          .sib-form-block__button, and id="EMAIL" on the input) — none of which
          survives restyling the form into this site's design system. It loads
          without error, silently never attaches a submit handler, and the
          Subscribe button does nothing. Verified live on both this site and
          litbible.net, which carries the same ported markup. So we submit with
          our own fetch() instead: the sibforms endpoint accepts cross-origin
          POSTs and returns a readable status, which is all we need.

          Keep the hidden `email_address_check` honeypot and `locale` fields —
          Brevo still expects both in the POST body. */}
      {!hideNewsletter && (
      <section
        class="footer-newsletter"
        aria-labelledby="footer-newsletter-heading"
      >
        <h2 id="footer-newsletter-heading" class="footer-newsletter__heading">
          Stay informed
        </h2>
        <p class="footer-newsletter__desc">
          News about LSC projects and updates, direct to your inbox.
        </p>

        {/* Status panels — hidden until the submit handler reveals one */}
        <div
          id="error-message"
          class="footer-newsletter__message footer-newsletter__message--error"
          role="alert"
          aria-live="assertive"
          aria-atomic="true"
        >
          Your subscription could not be saved. Please try again.
        </div>

        <div
          id="success-message"
          class="footer-newsletter__message footer-newsletter__message--success"
          role="status"
          aria-live="polite"
          aria-atomic="true"
        >
          Thanks for signing up! Check your email to confirm.
        </div>

        <form
          id="sib-form"
          class="footer-newsletter__form"
          method="POST"
          action="https://1742a6b7.sibforms.com/serve/MUIFAKkVDT78nzkJMnK-weBRAwIgbQLBZPO0abgGiDBE3y_q-MGXVZiM43FbTmBclg9Yxb4AJIykDYmOtwVRiWWQr9AFEcZh45QBCPH6niXWf1z2k8po10oRiJq4Lw4ySwI5zxb2GUxE02ZGuK6jb7NuGq6vh0wP9D9_-vxQ12P8dkWUjrjs0RCzZQyhLYowVoKxHMyd0eXecCqJPg=="
          data-type="subscription"
          novalidate
        >
          <div class="footer-newsletter__row">
            <label for="footer-email" class="sr-only">Email address</label>
            <input
              id="footer-email"
              type="email"
              name="EMAIL"
              placeholder="your@email.com"
              autocomplete="email"
              required
              class="footer-newsletter__input"
            />
            <button type="submit" class="footer-newsletter__submit" form="sib-form">
              Subscribe
            </button>
          </div>

          {/* Inline validation message for the email field */}
          <label
            class="footer-newsletter__field-error"
            for="footer-email"
            aria-live="polite"></label>

          {/* Turnstile — our own dedicated widget for this domain. Rendered
              implicitly by the API script scanning for .cf-turnstile; the
              token lands in a hidden cf-turnstile-response input inside. */}
          <div class="footer-newsletter__turnstile">
            <div
              class="cf-turnstile"
              data-sitekey="0x4AAAAAAD6VVgt-e5g_YNul"
              id="sib-captcha"
              data-language="en"
              data-theme="dark"
            >
            </div>
          </div>

          {/* Brevo required hidden fields */}
          <input
            type="text"
            name="email_address_check"
            value=""
            class="footer-newsletter__honeypot"
            aria-hidden="true"
            tabindex="-1"
            autocomplete="off"
          />
          <input type="hidden" name="locale" value="en" />
        </form>
      </section>
      )}
    </div>
  </div>
</footer>

<script>
  const el = document.getElementById("footerYear");
  if (el) el.textContent = String(new Date().getFullYear());
</script>

{/* Newsletter submit. Turnstile is lazy-loaded on first interaction with the
    form, so the footer costs nothing on pages nobody subscribes from; the POST
    is our own fetch (see the markup comment above for why Brevo's main.js is
    not used). Skipped when the newsletter form is hidden — otherwise this would
    bind to /unsubscribe's identically-id'd form. */}
{!hideNewsletter && <script is:inline>
  (function () {
    var form = document.getElementById("sib-form");
    if (!form) return;

    var btn = form.querySelector(".footer-newsletter__submit");
    var input = form.querySelector('[name="EMAIL"]');
    var fieldError = form.querySelector(".footer-newsletter__field-error");
    var successEl = document.getElementById("success-message");
    var errorEl = document.getElementById("error-message");
    var turnstileRequested = false;

    function loadTurnstile() {
      if (turnstileRequested) return;
      turnstileRequested = true;
      // /contact/ already loads the API for its own widget — don't double-load.
      if (document.querySelector('script[src*="turnstile/v0/api.js"]')) return;
      var s = document.createElement("script");
      s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
      s.async = true;
      document.body.appendChild(s);
    }

    function onInteraction() {
      form.removeEventListener("pointerover", onInteraction);
      form.removeEventListener("focusin", onInteraction);
      loadTurnstile();
    }
    form.addEventListener("pointerover", onInteraction);
    form.addEventListener("focusin", onInteraction);

    function show(el) {
      if (el) el.classList.add("is-visible");
    }
    function hide(el) {
      if (el) el.classList.remove("is-visible");
    }

    function fail(message) {
      hide(successEl);
      if (errorEl) {
        errorEl.textContent = message;
        show(errorEl);
      }
      btn.disabled = false;
      // Turnstile tokens are single-use, so the next attempt needs a fresh one.
      try {
        if (window.turnstile) window.turnstile.reset("#sib-captcha");
      } catch (e) {}
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      fieldError.textContent = "";
      hide(errorEl);

      if (!input.value || !input.checkValidity()) {
        fieldError.textContent = "Please enter a valid email address.";
        input.focus();
        return;
      }

      var tokenField = form.querySelector('[name="cf-turnstile-response"]');
      var token = tokenField ? tokenField.value : "";
      if (!token) {
        loadTurnstile();
        fail("Please wait for the verification to finish, then try again.");
        return;
      }

      btn.disabled = true;

      fetch(form.action, {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams({
          EMAIL: input.value,
          email_address_check: "",
          locale: "en",
          "cf-turnstile-response": token,
        }).toString(),
      })
        .then(function (res) {
          if (res.ok) {
            form.hidden = true;
            hide(errorEl);
            show(successEl);
          } else {
            fail("Your subscription could not be saved. Please try again.");
          }
        })
        .catch(function () {
          fail("Couldn't reach the server. Check your connection and try again.");
        });
    });
  })();
</script>}

<style>
  .site-footer {
    background: var(--ink);
    color: #c8c6c0;
    padding: clamp(3rem, 6vw, 5rem) 0 2rem;
    margin-top: 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 3rem 2.5rem;
    align-items: start;
  }

  /* Brand column */
  .footer-brand img {
    display: block;
    width: auto;
    margin-bottom: 1rem;
    opacity: 0.9;
    border-radius: 12px;
  }

  .footer-tagline {
    font-family: "Fraunces", serif;
    font-size: 1rem;
    line-height: 1.55;
    color: #c8c6c0;
    margin: 0 0 1rem 0;
  }

  .footer-legal {
    font-size: 0.8rem;
    line-height: 1.6;
    color: #8a8882;
    margin: 0;
  }

  /* Nav columns */
  .footer-col__heading {
    font-family: Inter, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a8882;
    margin: 0 0 1rem 0;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-col ul a {
    font-size: 0.95rem;
    color: #c8c6c0;
    text-decoration: none;
    transition: color 160ms;
  }

  .footer-col ul a:hover {
    color: var(--green);
    text-decoration: none;
  }

  /* CTA column */
  .footer-col--cta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }

  .footer-cta-btn {
    width: 100%;
    justify-content: center;
    font-size: 0.82rem;
    padding: 12px 18px;
  }

  .btn--outline {
    background: transparent;
    border-color: rgba(200, 198, 192, 0.4);
    color: #c8c6c0;
  }

  .btn--outline::before {
    background: var(--white);
  }

  .btn--outline:hover,
  .btn--outline:focus-visible {
    color: var(--ink);
  }

  /* Newsletter
     The footer band is a fixed dark surface in both themes, so anything that
     would resolve to a dark value in light mode (var(--border), var(--text))
     is hardcoded light here instead. The input keeps the theme tokens: it's an
     inset surface, so its background and text flip together and stay legible. */
  .footer-newsletter {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .footer-newsletter__heading {
    font-family: Inter, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a8882;
    margin: 0;
  }

  .footer-newsletter__desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #c8c6c0;
    margin: 0;
    max-width: 34ch;
  }

  /* Status panels — hidden until the submit handler adds .is-visible */
  .footer-newsletter__message {
    display: none;
    font-size: 0.85rem;
    line-height: 1.4;
    padding: 0.6rem 0.75rem;
    border-radius: 6px;
    border: 1px solid transparent;
  }

  .footer-newsletter__message.is-visible {
    display: block;
  }

  .footer-newsletter__message--error {
    color: #661d1d;
    background-color: #ffeded;
    border-color: #ff4949;
  }

  .footer-newsletter__message--success {
    color: #085229;
    background-color: #e7faf0;
    border-color: #13ce66;
  }

  .footer-newsletter__row {
    display: flex;
    margin-top: 0.15rem;
  }

  .footer-newsletter__input {
    flex: 1;
    min-width: 0;
    padding: 10px 14px;
    font-size: 0.9rem;
    font-family: inherit;
    color: var(--text);
    background: var(--surface-input);
    /* 0.55, not the 0.4 used elsewhere in this footer: in dark mode
       --surface-input sits at 1.2:1 against the band, so this border is the
       only thing that gives the field a shape. 0.55 clears 3:1; 0.4 doesn't. */
    border: 1px solid rgba(200, 198, 192, 0.55);
    border-right: none;
    border-radius: 8px 0 0 8px;
    outline: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .footer-newsletter__input:focus {
    border-color: var(--green);
    box-shadow: 0 0 0 2px rgba(32, 157, 80, 0.35);
  }

  .footer-newsletter__input::placeholder {
    color: var(--text);
    opacity: 0.5;
  }

  .footer-newsletter__submit {
    padding: 10px 16px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    color: var(--ink);
    background: var(--green);
    border: 1px solid var(--green);
    border-radius: 0 8px 8px 0;
    transition: background-color 160ms ease, color 160ms ease;
  }

  /* Hover goes to cream, not ink: an ink fill on the ink footer would erase
     the button's shape. Mirrors .btn--outline:hover above. */
  .footer-newsletter__submit:hover,
  .footer-newsletter__submit:focus {
    background: var(--cream);
    border-color: var(--cream);
    color: var(--ink);
  }

  .footer-newsletter__submit:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }

  /* Only disabled while a submit is in flight. */
  .footer-newsletter__submit:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .footer-newsletter__field-error {
    display: block;
    font-size: 0.78rem;
    color: #ff9a9a;
    margin-top: 0.2rem;
  }

  .footer-newsletter__turnstile {
    margin-top: 0.5rem;
  }

  .footer-newsletter__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 2rem;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
    .footer-col--cta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
    }
    .footer-cta-btn {
      width: auto;
    }
    /* The CTA column turns into a row here — keep the form on its own line
       rather than letting it sit beside the buttons. */
    .footer-newsletter {
      flex-basis: 100%;
      margin-top: 0.75rem;
    }
    .footer-newsletter__row {
      max-width: 360px;
    }
  }

  @media (max-width: 560px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-col--cta {
      flex-direction: column;
    }
    .footer-cta-btn {
      width: 100%;
    }
  }
</style>
